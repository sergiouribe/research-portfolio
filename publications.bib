@INCOLLECTION{Uribe2025-kd,
  title     = "Data foundations for trustworthy {AI} in dentistry",
  author    = "Uribe, Sergio E and Schwendicke, Falk",
  booktitle = "Artificial Intelligence for Oral Health Care",
  publisher = "Springer Nature Switzerland",
  address   = "Cham",
  pages     = "151--163",
  abstract  = "Artificial intelligence (AI) applications rely heavily on the
               quality and management of data used to train the AI models. This
               chapter discusses the importance of data for dental AI, starting
               from the foundational equation of computer processing, AI
               algorithms, and data. It emphasizes the role of data quality and
               provides an introduction to dataset preparation, including
               annotations, partitioning, size considerations, sources, and
               potential biases. As the demand for data grows, and also the
               privacy concerns, the chapter introduces federated learning as a
               novel approach to AI algorithm training preserving data privacy.
               Central to this discussion is the adoption of the FAIR (Findable,
               Accesible, Interoperable and Reusable) data principles in
               dentistry, allowing trustworthy and transparent AI applications.",
  year      =  2025,
  url       = "http://dx.doi.org/10.1007/978-3-031-84047-0_10",
  keywords  = "09 Uribe/02 Capitulos de libros Uribe",
  doi       = "10.1007/978-3-031-84047-0\_10",
  isbn      = "9783031840463,9783031840470",
  language  = "en"
}

