% ============================================================
% publications.bib — optional manual additions to the portfolio
% ============================================================
% Anything in this file is merged into the publication list at
% page load. Use it for items NOT yet in ORCID (the page already
% pulls everything in your ORCID record automatically).
%
% Duplicates are skipped automatically (matched by DOI or title),
% so it is safe to leave entries here after they appear in ORCID.
% If an entry has a DOI that OpenAlex knows, it is enriched with
% citation counts, co-authors and open-access status automatically.
%
% Example entry (remove the leading % signs to activate):
%
% @article{uribe2026example,
%   title   = {Title of the new paper},
%   author  = {Uribe, Sergio E. and Coauthor, First},
%   journal = {Journal Name},
%   year    = {2026},
%   doi     = {10.1000/xyz123}
% }
%
% Supported types: @article, @inproceedings, @incollection,
% @book, @phdthesis, @techreport, @misc, @unpublished
% Supported fields: title, author, journal/booktitle/publisher,
% year, doi, url
